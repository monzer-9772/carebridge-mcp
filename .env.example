# CareBridge site the MCP connects to.
# Default: live sandbox at carebridge-tfui.onrender.com
# For local dev: http://localhost:3000
CAREBRIDGE_BASE_URL=https://carebridge-tfui.onrender.com

# MCP transport
# - stdio: local, single-client (default for IDE integrations)
# - http:  remote, multi-client
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3100

# Request limits
CAREBRIDGE_HTTP_TIMEOUT_MS=15000
CAREBRIDGE_USER_AGENT=carebridge-mcp-server/0.1
